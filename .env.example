# localhost here is correct for running the app directly on the host
# (venv + `docker compose up -d db redis` for just the data services).
# Inside the compose network, the backend/worker containers need `db`/
# `redis` (the service names) instead of `localhost` — docker-compose.yml
# overrides these two vars for those two services specifically, so you
# don't need a second .env file, just don't "fix" localhost to db/redis
# here or host-based dev breaks instead.
ENVELOPS_DATABASE_URL=postgresql+asyncpg://envelops:envelops@localhost:5432/envelops
ENVELOPS_REDIS_URL=redis://localhost:6379/0
ENVELOPS_JWT_SECRET=change-me
# Free tier: https://aistudio.google.com/apikey — get one and put it in
# your local .env, never here or in a commit.
ENVELOPS_GEMINI_API_KEY=
# Dev-only tenant switcher: a login dropdown that skips the password form
# entirely -- a COMPLETE authentication bypass, not a lesser-privilege dev
# mode. Leave this false/unset in every environment except your own local
# machine while actively testing multiple seeded tenants. Never set this
# to true in any shared, deployed, or otherwise reachable environment.
ENVELOPS_DEV_AUTH_BYPASS_ENABLED=false
