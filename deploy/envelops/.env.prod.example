# Copy to .env.prod and fill in all values before first deploy.
# Never commit .env.prod itself -- see the repo's own .gitignore.

# -- Database -----------------------------------------------------------
# Must match the password set for the envelops DB user in SERVER_SETUP.md.
# The full ENVELOPS_DATABASE_URL is assembled in docker-compose.prod.yml
# using this value.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ENVELOPS_DB_PASSWORD=change-me-strong-password

# -- Auth -------------------------------------------------------------------
# Signs session JWTs (app/auth/security.py) -- a leaked value lets anyone
# forge a valid session for any user. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ENVELOPS_JWT_SECRET=change-me-random-secret

# -- Internal fake-commerce endpoint -----------------------------------------
# Shared bearer token between this backend's own commerce connectors
# (app/commerce/connectors.py) and its own internal-only fake-commerce
# endpoint (app/commerce/fake_platform_api.py) -- never reachable from
# outside, never proxied by nginx (see ../nginx/envelops.conf, which has
# no location for /internal/). Not real security, just enough that the
# connector has to build a real Authorization header and handle a real
# 401. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ENVELOPS_FAKE_COMMERCE_INTERNAL_TOKEN=change-me-random-token

# -- AI -----------------------------------------------------------------------
# A free key from https://aistudio.google.com/apikey -- covers both
# generation and embeddings (app/core/config.py's single gemini_api_key).
# REQUIRED: every pipeline stage (intent understanding, knowledge
# grounding, lead scoring, order-status/inventory tool-calling) runs on
# this for real, not mocked. See CLAUDE.md's free-tier quota gotcha
# (per-model, not just per-key -- gemini-flash-lite-latest is the one
# confirmed working generation model on this project's account as of
# 2026-08; re-check `GET .../v1beta/models?key=...` before assuming any
# other model name just works) if AI requests start failing with a
# persistent 429.
ENVELOPS_GEMINI_API_KEY=change-me-gemini-api-key

# -- Demo mode ----------------------------------------------------------------
# true for the public demo deployment -- every mutating endpoint (knowledge
# source CRUD, settings, escalation resolve/trigger-phrases, the channel AI
# toggle, inbound channel webhooks) 403s instead of writing anything, a
# background Celery-beat job keeps the dashboard feeling alive (10-15
# simulated DMs/day across all 5 channel types, 7-day rolling retention via
# purge_stale_demo_data), and a no-password tenant switch
# (GET /auth/demo-tenants + POST /auth/demo-login) replaces login entirely.
# MUST stay false outside a local/throwaway environment or an actual public
# demo deployment -- see app/core/config.py's own warning.
ENVELOPS_DEMO_MODE_ENABLED=true
