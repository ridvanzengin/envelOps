FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend .

# Vite bakes import.meta.env.VITE_* at build time, not runtime -- must be
# passed as a build ARG, not a compose `environment:` entry (which only
# affects a dev server's own live process, and this is a static build).
# Empty string is intentional for the production build: same-origin
# relative paths once nginx routes both frontend and every backend router
# prefix under one domain (see ../../deploy/nginx/envelops.conf) -- no
# CORS middleware exists on the backend (see vite.config.ts's own dev-only
# proxy comment), so this must stay same-origin in production too.
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
