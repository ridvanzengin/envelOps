# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
dist/
build/
.vite/

# Env / secrets -- exact names, not a glob. `.env.*` with a `!.env.example`
# negation (the previous form here) silently swallowed anything that
# wasn't literally named ".env.example" -- caught when
# deploy/envelops/.env.prod.example needed committing but the glob still
# matched it. Explicit names avoid the whole class of gotcha, same
# pattern IoTOps's own .gitignore already uses.
.env
.env.prod

# Docker
*.pid

# Downloaded third-party datasets (research data, not source)
backend/data/

# OS / editor
.DS_Store
.vscode/
.idea/

# Logs
*.log
